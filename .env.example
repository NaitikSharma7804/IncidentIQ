# IncidentIQ Platform Environment Configuration
# Copy this file to .env and supply environment-appropriate parameters

# Application Environment: development | production | test
INCIDENTIQ_ENV=development

# JWT Secret: Minimum 32 characters in production (cannot start with "change")
INCIDENTIQ_JWT_SECRET=your_32_character_minimum_random_secret_here

# JWT Expiration in minutes (default: 60)
INCIDENTIQ_JWT_TTL_MINUTES=60

# Database Connection URL:
# Local/SQLite: sqlite:///incidentiq.db
# PostgreSQL: postgresql://username:password@localhost:5432/incidentiq
INCIDENTIQ_DATABASE_URL=sqlite:///./backend/incidentiq.db

# CORS Allowed Origins (comma-separated, NO wildcards '*' allowed)
INCIDENTIQ_CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://127.0.0.1:5173

# Demo Password for seeded test users in development
INCIDENTIQ_DEMO_PASSWORD=demo-only

# Rate Limiting (SlowAPI format)
INCIDENTIQ_RATE_LIMIT=120/minute
INCIDENTIQ_LOGIN_RATE_LIMIT=100/minute

# Optional LLM-Assisted Mode (OpenAI-compatible)
# System operates 100% deterministically without API keys when disabled
INCIDENTIQ_ENABLE_LLM=false
INCIDENTIQ_LLM_API_KEY=
INCIDENTIQ_LLM_BASE_URL=https://api.openai.com/v1
INCIDENTIQ_LLM_MODEL=gpt-4o-mini

# Optional Redis Cache URL (In-process fallback active when omitted)
INCIDENTIQ_REDIS_URL=

# Debug Logging (true/false)
DEBUG=false

